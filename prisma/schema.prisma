generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoRecurso {
  material
  mano_obra
  equipo
  transporte

  @@map("tipo_recurso")
}

enum Rol {
  administrador
  presupuestista
  solo_lectura

  @@map("rol")
}

model Recurso {
  id                 String            @id @default(uuid())
  codigo             String            @unique
  tipo               TipoRecurso
  categoria          String?
  descripcion        String
  unidad             String
  costoUnitario      Decimal           @map("costo_unitario") @db.Decimal(12, 2)
  fuente             String            @default("Manual")
  fechaActualizacion DateTime          @default(now()) @map("fecha_actualizacion")
  activo             Boolean           @default(true)
  historialPrecios   HistorialPrecio[]
  apuDetalles        ApuDetalle[]

  @@map("recursos")
}

model HistorialPrecio {
  id            String   @id @default(uuid())
  recursoId     String   @map("recurso_id")
  recurso       Recurso  @relation(fields: [recursoId], references: [id])
  precio        Decimal  @db.Decimal(12, 2)
  fuente        String?
  fecha         DateTime @default(now())
  registradoPor String?  @map("registrado_por")

  @@index([recursoId, fecha(sort: Desc)])
  @@map("historial_precios")
}

model Actividad {
  id               String            @id @default(uuid())
  codigo           String            @unique
  nombre           String
  unidad           String
  apuDetalles      ApuDetalle[]
  apuCostoCache    ApuCostoCache?
  presupuestoItems PresupuestoItem[]

  @@map("actividades")
}

model ApuDetalle {
  id                String    @id @default(uuid())
  actividadId       String    @map("actividad_id")
  actividad         Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  recursoId         String    @map("recurso_id")
  recurso           Recurso   @relation(fields: [recursoId], references: [id])
  cantidadPorUnidad Decimal   @map("cantidad_por_unidad") @db.Decimal(12, 4)

  @@unique([actividadId, recursoId])
  @@index([recursoId])
  @@map("apu_detalle")
}

model ApuCostoCache {
  actividadId     String    @id @map("actividad_id")
  actividad       Actividad @relation(fields: [actividadId], references: [id], onDelete: Cascade)
  costoMateriales Decimal   @map("costo_materiales") @db.Decimal(12, 2)
  costoManoObra   Decimal   @map("costo_mano_obra") @db.Decimal(12, 2)
  costoEquipo     Decimal   @map("costo_equipo") @db.Decimal(12, 2)
  costoTransporte Decimal   @map("costo_transporte") @db.Decimal(12, 2)
  costoTotal      Decimal   @map("costo_total") @db.Decimal(12, 2)
  fechaCalculo    DateTime  @map("fecha_calculo")

  @@map("apu_costo_cache")
}

model Proyecto {
  id            String        @id @default(uuid())
  nombre        String
  cliente       String?
  ubicacion     String?
  estado        String        @default("En elaboración")
  valorEstimado Decimal?      @map("valor_estimado") @db.Decimal(14, 2)
  presupuestos  Presupuesto[]

  @@map("proyectos")
}

model Presupuesto {
  id              String            @id @default(uuid())
  proyectoId      String            @map("proyecto_id")
  proyecto        Proyecto          @relation(fields: [proyectoId], references: [id])
  nombre          String?
  fecha           DateTime          @default(now())
  pctIndirectos   Decimal           @default(15.00) @map("pct_indirectos") @db.Decimal(5, 2)
  pctUtilidad     Decimal           @default(10.00) @map("pct_utilidad") @db.Decimal(5, 2)
  pctImpuestos    Decimal           @default(15.00) @map("pct_impuestos") @db.Decimal(5, 2)
  costosDirectos  Decimal           @default(0) @map("costos_directos") @db.Decimal(14, 2)
  costoMateriales Decimal           @default(0) @map("costo_materiales") @db.Decimal(14, 2)
  costoManoObra   Decimal           @default(0) @map("costo_mano_obra") @db.Decimal(14, 2)
  costoEquipo     Decimal           @default(0) @map("costo_equipo") @db.Decimal(14, 2)
  costoTransporte Decimal           @default(0) @map("costo_transporte") @db.Decimal(14, 2)
  indirectos      Decimal           @default(0) @db.Decimal(14, 2)
  utilidad        Decimal           @default(0) @db.Decimal(14, 2)
  impuestos       Decimal           @default(0) @db.Decimal(14, 2)
  total           Decimal           @default(0) @db.Decimal(14, 2)
  items           PresupuestoItem[]

  @@map("presupuestos")
}

model PresupuestoItem {
  id                     String      @id @default(uuid())
  presupuestoId          String      @map("presupuesto_id")
  presupuesto            Presupuesto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  actividadId            String      @map("actividad_id")
  actividad              Actividad   @relation(fields: [actividadId], references: [id])
  cantidadProyecto       Decimal     @map("cantidad_proyecto") @db.Decimal(12, 2)
  costoUnitarioCongelado Decimal     @map("costo_unitario_congelado") @db.Decimal(12, 2)
  costoMaterialesCong    Decimal     @map("costo_materiales_cong") @db.Decimal(12, 2)
  costoManoObraCong      Decimal     @map("costo_mano_obra_cong") @db.Decimal(12, 2)
  costoEquipoCong        Decimal     @map("costo_equipo_cong") @db.Decimal(12, 2)
  costoTransporteCong    Decimal     @map("costo_transporte_cong") @db.Decimal(12, 2)
  total                  Decimal     @db.Decimal(14, 2)

  @@unique([presupuestoId, actividadId])
  @@map("presupuesto_items")
}

model Usuario {
  id           String  @id @default(uuid())
  nombre       String
  email        String  @unique
  passwordHash String  @map("password_hash")
  rol          Rol     @default(presupuestista)
  activo       Boolean @default(true)

  @@map("usuarios")
}

model Configuracion {
  id               Int     @id
  empresa          String?
  ruc              String?
  moneda           String  @default("NIO")
  pctIndirectosDef Decimal @default(15.00) @map("pct_indirectos_def") @db.Decimal(5, 2)
  pctUtilidadDef   Decimal @default(10.00) @map("pct_utilidad_def") @db.Decimal(5, 2)
  pctImpuestosDef  Decimal @default(15.00) @map("pct_impuestos_def") @db.Decimal(5, 2)

  @@map("configuracion")
}
